# Optional for public repositories; required for private repositories and higher GitHub API rate limits.
GITHUB_TOKEN=your_github_token_here

# Required. Comma-separated repositories that this service is allowed to review.
ALLOWED_GITHUB_REPOSITORIES=Khumo-Hub/AI-PR-Reviewer-application

# Required for validating GitHub webhook X-Hub-Signature-256 signatures.
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Maximum unified diff size accepted by the service. Must be a positive integer.
MAX_PR_DIFF_BYTES=500000

# Required for AI review requests. Never commit a real key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Required for protected review and Microsoft connection endpoints.
REVIEW_API_KEY=replace_with_a_long_random_secret

# Required for Microsoft delegated OAuth. Register the app for organizational + personal Microsoft accounts.
MICROSOFT_CLIENT_ID=your_application_client_id
MICROSOFT_CLIENT_SECRET=your_application_client_secret
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/common
MICROSOFT_REDIRECT_URI=https://your-render-service.onrender.com/microsoft/callback

# Local token-cache path. On ephemeral hosts this must be re-authorized after filesystem replacement.
# In production, point this to a persistent disk, for example /var/data/msal_token_cache.json.
MICROSOFT_TOKEN_CACHE_PATH=.data/msal_token_cache.json

# Optional persistent idempotency state. Point this to a persistent disk in production.
# Leave unset on an ephemeral development host.
REVIEW_STATE_PATH=

# Recipient placed in the saved Outlook review draft.
OUTLOOK_REVIEW_RECIPIENT=reviewer@example.com
