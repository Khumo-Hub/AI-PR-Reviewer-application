# Optional for public repositories; required for private repositories and higher GitHub API rate limits.
GITHUB_TOKEN=your_github_token_here

# Required. Comma-separated repositories that this service is allowed to review.
ALLOWED_GITHUB_REPOSITORIES=Khumo-Hub/AI-PR-Reviewer-application

# Maximum unified diff size accepted by the service.
MAX_PR_DIFF_BYTES=500000

# Required for AI review requests. Never commit a real key.
OPENAI_API_KEY=your_openai_api_key_here

# Optional. Override the default API model used for PR review.
OPENAI_MODEL=gpt-5-mini

# Required to call the paid AI review and Outlook draft endpoints. Send this value in the X-API-Key header.
REVIEW_API_KEY=replace_with_a_long_random_secret

# Required for renewable Microsoft Graph app-only authentication.
MICROSOFT_TENANT_ID=your_entra_tenant_id
MICROSOFT_CLIENT_ID=your_entra_application_client_id
MICROSOFT_CLIENT_SECRET=your_entra_application_client_secret

# Mailbox in which the Outlook draft should be created.
OUTLOOK_MAILBOX=reviewer@example.com

# Recipient placed in the saved Outlook review draft.
OUTLOOK_REVIEW_RECIPIENT=reviewer@example.com
